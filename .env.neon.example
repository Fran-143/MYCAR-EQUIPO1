# Plantilla para Neon (copiar a .env.neon en la raíz del repo).
# .env.neon está gitignored — no lo subas a Git.
# NO uses este archivo para Docker; el .env local sigue siendo PostgreSQL Docker.

# Conexión directa (sin -pooler) para validación inicial / Flyway futuro.
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-autumn-night-bcyfc2fr.c-16.us-east-1.aws.neon.tech:5432/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=

# Credenciales: scripts/solicitar_password_neon.ps1 (dialogo oculto, no chat).
# Arranque: scripts/iniciar_backend_neon.ps1 carga estas vars al proceso
# (no importa .env.neon como ConfigData: Spring no reconoce la extension .neon).
