alerta [label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#14324A" ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#FFFFFF"><B>ALERTA</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0F766E">🔑 id_alerta</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155"> id_vehiculo</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155"> id_tipo_mantenimiento</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569"> criterio</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B">VARCHAR(24)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569"> origen</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B">VARCHAR(24)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569"> categoria</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B">VARCHAR(32)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569"> servicio_otro</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B">VARCHAR(160)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569"> unidad_tiempo</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B">VARCHAR(24)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569"> cantidad_tiempo</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569"> fecha_base</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569"> id_mantenimiento_referencia</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569"> creada_utc</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569"> fecha_objetivo</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#64748B">… otros campos</FONT></TD></TR></TABLE>>];
historial_alerta [label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#14324A" ALIGN="LEFT" COLSPAN="2"><FONT COLOR="#FFFFFF"><B>HISTORIAL_ALERTA</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0F766E">🔑 id_historial_alerta</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155"> id_alerta</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569"> estado_anterior</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B">VARCHAR(16)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569"> estado_nuevo</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B">VARCHAR(16)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569"> motivo</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B">VARCHAR(48)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569"> fecha_cambio_utc</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B">TIMESTAMPTZ</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155"> id_lectura_evidencia</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#475569"> version_destino</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748B">INTEGER</FONT></TD></TR></TABLE>>];
