POSTGRES_DB=mycar_mvp
POSTGRES_USER=mycar
POSTGRES_PASSWORD=root
POSTGRES_PORT=5432

# Neon (nube, US$0): NO uses este .env. Copia .env.neon.example → .env.neon
# y arranca con scripts/iniciar_backend_neon.ps1 (perfil Spring neon).

# RF01/RF03 correo OTP — deja modo=desarrollo para emulador/CI sin SMTP.
# SMTP local (Gmail App Password u otro):
# mycar.verificacion.mail.modo=smtp
# spring.mail.host=smtp.gmail.com
# spring.mail.port=587
# spring.mail.username=cuenta.prueba@gmail.com
# spring.mail.password=xxxx xxxx xxxx xxxx
# spring.mail.properties.mail.smtp.auth=true
# spring.mail.properties.mail.smtp.starttls.enable=true
# mycar.verificacion.mail.from=cuenta.prueba@gmail.com
#
# Brevo HTTPS (recomendado en Render Free; no poner la API key en git):
# mycar.verificacion.mail.modo=brevo
# mycar.verificacion.brevo.api-key=
# mycar.verificacion.mail.from=remitente-verificado@tu-cuenta
# mycar.verificacion.brevo.from-name=MyCar
