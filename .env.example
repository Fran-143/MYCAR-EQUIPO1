POSTGRES_DB=mycar_mvp
POSTGRES_USER=mycar
POSTGRES_PASSWORD=root
POSTGRES_PORT=5432

# RF02 MFA TOTP (ADMIN) — solo local/USB. Generar: [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))
# MYCAR_MFA_ENABLED=true
# MYCAR_MFA_KEY_ID=v1
# MYCAR_MFA_AES_KEY=
# MYCAR_ADMIN_BOOTSTRAP_SECRET=


# Documentos SOAT (Supabase Storage) — ver docs/soat_supabase_env.md
# MYCAR_DOCUMENTOS_MODO=supabase
# MYCAR_DOCUMENTOS_SUPABASE_URL=https://xxxx.supabase.co
# MYCAR_DOCUMENTOS_SUPABASE_SECRET=sb_secret_...
# MYCAR_DOCUMENTOS_SUPABASE_BUCKET=mycar-documentos-privados

# Taller piloto local (SOLO Docker/local; NUNCA pegar el número real en Git; NUNCA en Neon).
# Requiere usuario-id > 0 y WhatsApp PE válido cuando habilitado=true.
# mycar.taller-piloto.habilitado=true
# MYCAR_TALLER_PILOTO_WHATSAPP=9XXXXXXXX
# MYCAR_TALLER_PILOTO_USUARIO_ID=<id_usuario_local>
# MYCAR_TALLER_PILOTO_CONTACTO_AUTORIZADO=false


# Neon (nube, US$0): NO uses este .env. Copia .env.neon.example → .env.neon
# y arranca con scripts/iniciar_backend_neon.ps1 (perfil Spring neon).

# RF01/RF03 correo OTP — deja modo=desarrollo para emulador/CI sin SMTP.
# SMTP local (Gmail App Password u otro):
# mycar.verificacion.mail.modo=smtp
# spring.mail.host=smtp.gmail.com
# spring.mail.port=587
# spring.mail.username=cuenta.prueba@gmail.com
# spring.mail.password=xxxx xxxx xxxx xxxx
# spring.mail.properties.mail.smtp.auth=true
# spring.mail.properties.mail.smtp.starttls.enable=true
# mycar.verificacion.mail.from=cuenta.prueba@gmail.com
#
# Brevo HTTPS (recomendado en Render Free; no poner la API key en git):
# mycar.verificacion.mail.modo=brevo
# mycar.verificacion.brevo.api-key=
# mycar.verificacion.mail.from=remitente-verificado@tu-cuenta
# mycar.verificacion.brevo.from-name=MyCar
